# Local env files
.env
.env.*
!.env.example
INSTRUCTIONS.txt
1_reference/
.codex
.agents

# Editor and OS noise
.DS_Store
.vscode/
~$*.*

# Build/runtime output
*.log
*.pid
*.tmp
tmp/
logs/
caddy_data/
caddy_config/
state/*
!state/.gitkeep

# Repo-owned build and container assets must stay trackable even if broader
# local ignore rules get added later.
!/build/
!/build/snapweb/
!/build/snapweb/**
!/docker/
!/docker/app/
!/docker/app/**
!/docker/caddy/
!/docker/caddy/**
!/docker/host-stubs/
!/docker/host-stubs/**

# User-provided media and generated playlists
music/*
!music/.gitkeep
!music/Javolenus_-_C95-RoutineMaintenanceMission.mp3
!music/_ghost_-_Reverie_(small_theme).mp3
!music/_ghost_-_Two_Swords.mp3
config/playlists/*
!config/playlists/.gitkeep

# Python/cache artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Native build artifacts
*.d
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.smod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
